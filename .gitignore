# --- shared by every sapphire-turtle repository (sapphire-turtle/.github, templates/.gitignore) ---

# Generated by Cargo
debug
target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# Agent and tooling scratch: Claude Code settings and worktrees, the
# subagent-driven-development ledger, local git worktrees
.claude
.superpowers/
.worktrees/

# macOS Finder metadata
.DS_Store

# --- repository specific ---

# The demo's mobile builds (crates/alumina-demo/README.md): the generated Xcode project and
# its build output, the developer's own signing settings, the Gradle build and the Rust
# libraries copied into it, and what Mobile CI leaves (screenshots, logs).
/crates/alumina-demo/ios/AluminaDemo.xcodeproj
/crates/alumina-demo/ios/Info.plist
/crates/alumina-demo/ios/build
/crates/alumina-demo/ios/Local.xcconfig
/crates/alumina-demo/ios/*.log
/crates/alumina-demo/ios/screenshot.png
/crates/alumina-demo/android/.gradle
/crates/alumina-demo/android/local.properties
/crates/alumina-demo/android/app/build
/crates/alumina-demo/android/build
/crates/alumina-demo/android/app/src/main/jniLibs
/crates/alumina-demo/android/logcat.txt
/crates/alumina-demo/android/screenshot.png
